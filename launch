#!/usr/bin/env bash
#
# launch -- assemble the boot bundle, print the exact QEMU command line, and boot it with
# the serial console wired to this terminal's stdin/stdout (Ctrl-A X quits).
#
# Usage: ./launch [--arch rv32|rv64] [--smp N] [--debug] [--print-only]
#                 [--program NAME|PATH]...
#   --arch       target width (default rv64); rv32 boots RustSBI from bios/
#   --smp N      hart count (default 1)
#   --debug      start paused with QEMU's gdb stub on :1234
#   --print-only print the QEMU command and exit without booting
#   --program    a program to start: a test-programs binary name, or a path to an ELF
#
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

arch=rv64
smp=1
debug=0
print_only=0
progs=()
while (($#)); do
    case "$1" in
        -a|--arch)   arch="${2:?--arch needs rv32 or rv64}"; shift 2 ;;
        --arch=*)    arch="${1#*=}"; shift ;;
        --smp)       smp="${2:?--smp needs a hart count}"; shift 2 ;;
        --smp=*)     smp="${1#*=}"; shift ;;
        --debug)     debug=1; shift ;;
        --print-only) print_only=1; shift ;;
        --program)   progs+=(--program "${2:?--program needs a name or path}"); shift 2 ;;
        --program=*) progs+=(--program "${1#*=}"); shift ;;
        -h|--help)   sed -n '2,12p' "$0"; exit 0 ;;
        *) echo "launch: unknown argument: $1" >&2; exit 2 ;;
    esac
done

cmd=(cargo run --quiet -p testbench -- --arch "$arch" --smp "$smp" --run --print-qemu)
if [ "$debug" = 1 ]; then cmd+=(--debug); fi
if [ "$print_only" = 1 ]; then cmd+=(--print-only); fi
cmd+=("${progs[@]}")
exec "${cmd[@]}"