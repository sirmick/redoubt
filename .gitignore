# Toolchain caches (CARGO_HOME / RUSTUP_HOME live inside the workspace). Keep the cargo
# config, ignore the rest.
/.cargo/*
!/.cargo/config.toml
/.rustup/

# Build output
/target
**/*.rs.bk
*.map

# Generated bundle and disk images
/target/image/
*.uf2
*.img

# Vendored inputs that are large or reconstructible and should not bloat the repo:
# the OTP/Elixir archives and the BEAM reference sources.
/toolchains/
/reference/

# Vendored sub-trees rebuild here
/bios/target/
/userland/otp/target/
/userland/otp/build/

# Fuzz outputs
libs/*/fuzz/corpus/
libs/*/fuzz/artifacts/
libs/*/fuzz/target/

# Editors / misc
*~
.vs
__pycache__/
*.pyc
todo.md
notes/
# KDevelop project files
.kdev4/
*.kdev4
