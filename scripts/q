#!/usr/bin/env python3
"""q: one scheduler for the whole machine; every member's build, test and QEMU run goes through it.

    q daemon [--cores 0-23] [--quiet 20-23] [--ports 23000-23999]
                                             the scheduler (one per machine; `q ping` checks)
    q run [--cores N] [--quiet] [--lock NAME] [--share NAME] [--ports N] [--prio P] [--tenant T]
          [--name S] -- <cmd...>
                                             wait for a lease of N cores, run <cmd> pinned to them
                                             (taskset), exit with its code; the lease ends with
                                             this process, however it ends; --cores 0 leases no
                                             core and pins nothing: a job that only holds a lock
    q ls                                     the core map, the running jobs, the queue, and a line
                                             per tenant (what it has running and waiting; a make
                                             submits its targets as it reaches them, so a stream's
                                             remainder is larger than the queue shows)
    q log [N]                                the last N finished jobs (default 30)
    q stop                                   end the daemon (running jobs keep their cores)

A job says how many cores it needs; the daemon bin-packs leases onto real core IDs and the
client pins the command there, so a QEMU guest gets a core of its own and a build gets its N
(CARGO_BUILD_JOBS and RUST_TEST_THREADS are set to N; make's jobserver flags are stripped).
A job's scratch directory is $REDOUBT_TMP, by default .tmp at the root of the checkout this script
is in (ignored by git, so deleting the checkout removes it); the job gets it as REDOUBT_TMP and as
TMPDIR, since /tmp may be a RAM filesystem that a sweep's scratch fills.

Classes are flags, not names to learn:
  --quiet     a host-clock case: runs alone on the reserved quiet core set, one at a time
              among quiet jobs, while everything else keeps running on the general cores
  --lock NAME a named lock, taken exclusively: the job runs alone among every job naming the
              lock either way, and from the moment it waits no new --share taker of the lock
              starts ahead of it, so a stream of sharers cannot hold it off; the whole-bench
              targets of jobs.mk hold `qemu` so for the run, as a lock-only job (--cores 0)
  --share NAME the same lock taken shared: sharers run beside each other and wait while an
              exclusive taker holds the lock or waits for it (a single boot case takes `qemu`
              so, and so runs beside other single boots but never beside a whole bench). A job
              held on a lock prints one line on stderr naming who holds it and since when, then
              runs when it is free; it never fails for the wait. A lock is never taken inside a
              job holding it shared: with an exclusive taker waiting, the inner take would wait
              on the outer
  --ports N   N consecutive host ports no other lease holds, from the daemon's pool (--ports on
              the daemon, default 23000-23999, below Linux's ephemeral range); the job gets them
              as REDOUBT_PORTS=lo-hi and the bench binds its forwards inside the range, so two
              [net] boots never race for a port. A daemon that predates the flag answers with
              no ports; the client then runs the job under `--lock net` instead, the old rule,
              and says so on stderr: restart the daemon
  --prio P    higher runs first (default 5, or $Q_PRIO; a whole-bench train exports Q_PRIO=0 so
              members' gates go first; a sweep too)
  Fairness: tenants are served round-robin by running cores, and while another tenant waits no
  tenant grows past half the general cores, so a long train or a big suite cannot hold the
  machine against everyone's gates. A job that cannot fit for 60 s takes the free cores if they
  are at least half its ask (it only runs slower); below that the free cores are held for it,
  and after 180 s it takes whatever is free, so a hold never outlasts the jobs it waits on.
  A restarted daemon adopts the jobs still running under the old one (their taskset pins, and
  the REDOUBT_PORTS, Q_LOCK and Q_SHARE in their environment) and frees their cores, ports and
  locks as they exit, so a restart never double-books the machine or forgets a hold.
  --tenant T  who is asking (default: the worktree, from cwd); tenants share the machine
              round-robin so one cannot starve the rest

There is no drain mode. A lease belongs to the client's connection: a killed client frees its
cores at once, so nothing leaks. The daemon runs nothing itself.
"""
import argparse
import json
import os
import selectors
import signal
import socket
import subprocess
import sys
import time

SOCK = os.environ.get("REDOUBT_Q", "/tmp/redoubt-q.sock")
LOG = SOCK + ".log"
PORTS = "23000-23999"  # the daemon's default port pool: below the ephemeral range (32768-60999)
PORT_LOCK = "net"  # what a --ports job falls back to under a daemon that leases no ports
STARVE_S = 60.0  # after this a starved job takes what is free if >= half its ask; after 3x, any core
RETRY_S = 600.0  # a client waits this long for a daemon to answer (across a restart)


def parse_cores(spec):
    out = []
    for part in spec.split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            a, b = part.split("-")
            out.extend(range(int(a), int(b) + 1))
        else:
            out.append(int(part))
    return sorted(set(out))


def fmt_cores(cores):
    cores = sorted(cores)
    if not cores:
        return "-"
    runs, start, prev = [], cores[0], cores[0]
    for c in cores[1:]:
        if c == prev + 1:
            prev = c
            continue
        runs.append((start, prev))
        start = prev = c
    runs.append((start, prev))
    return ",".join(f"{a}-{b}" if a != b else f"{a}" for a, b in runs)


def parse_range(spec):
    """'lo-hi' (inclusive) as (lo, hi); None for anything else."""
    try:
        lo, hi = spec.strip().split("-")
        lo, hi = int(lo), int(hi)
    except (AttributeError, ValueError):
        return None
    return (lo, hi) if 0 < lo <= hi <= 65535 else None


def port_free(port):
    """True if nothing on the host holds `port`, TCP or UDP, on the loopback interface right
    now: the pool keeps leases apart from each other, the probe keeps them off a stranger."""
    for kind in (socket.SOCK_STREAM, socket.SOCK_DGRAM):
        try:
            with socket.socket(socket.AF_INET, kind) as s:
                s.bind(("127.0.0.1", port))
        except OSError:
            return False
    return True


# ----------------------------------------------------------------------------- daemon


def process_start(pid):
    """When the process started, as a time.time() value: its start in clock ticks since boot
    (field 22 of /proc/<pid>/stat, after the parenthesised name) plus the boot time; now if
    /proc does not say."""
    try:
        with open(f"/proc/{pid}/stat") as f:
            ticks = int(f.read().rsplit(")", 1)[1].split()[19])
        with open("/proc/stat") as f:
            btime = int(next(l for l in f if l.startswith("btime")).split()[1])
        return btime + ticks / os.sysconf("SC_CLK_TCK")
    except (OSError, ValueError, IndexError, StopIteration):
        return time.time()


class Job:
    __slots__ = ("conn", "req", "seq", "t_in", "t_start", "cores", "ports", "quiet", "lock", "share",
                 "tenant", "told")

    def __init__(self, conn, req, seq):
        self.conn = conn
        self.req = req
        self.seq = seq
        self.t_in = time.time()
        self.t_start = None
        self.cores = []
        self.ports = None  # (lo, hi) once leased
        self.quiet = bool(req.get("quiet"))
        self.lock = req.get("lock") or None
        self.share = req.get("share") or None
        self.tenant = req.get("tenant") or "?"
        self.told = False  # the one waiting line a held job is sent

    @property
    def want(self):
        return max(0, int(self.req.get("cores") if self.req.get("cores") is not None else 1))

    @property
    def want_ports(self):
        return max(0, int(self.req.get("ports") or 0))

    @property
    def tags(self):
        """The lease's marks for a log or status line."""
        return (f"{' quiet' if self.quiet else ''}{' lock=' + self.lock if self.lock else ''}"
                f"{' share=' + self.share if self.share else ''}"
                f"{' ports=%d-%d' % self.ports if self.ports else ''}")

    @property
    def prio(self):
        return int(self.req.get("prio") or 5)

    @property
    def name(self):
        return str(self.req.get("name") or " ".join(self.req.get("cmd") or [])[:60])

    def holder(self, waiting=False):
        """Who this job is, for the line a job held behind it is sent: its tenant, name and
        cwd, and since when it has held (or waited for) the lock."""
        return {"tenant": self.tenant, "name": self.name, "cwd": self.req.get("cwd") or "?",
                "since": self.t_in if waiting else self.t_start, "waiting": waiting}


class Daemon:
    def __init__(self, all_cores, quiet_cores, ports):
        self.quiet_set = [c for c in quiet_cores if c in all_cores]
        self.general = [c for c in all_cores if c not in self.quiet_set]
        self.free = set(self.general)
        self.pool = ports  # (lo, hi): the host ports this daemon leases
        self.leased_ports = set()  # every port under a running or adopted lease
        self.quiet_busy = None  # the one quiet job
        self.locks = {}  # name -> the job holding it exclusively
        self.shared = {}  # name -> the jobs holding it shared
        self.waiting = []  # Job, in arrival order
        self.running = {}  # conn -> Job
        self.bufs = {}  # conn -> partial line
        self.adopted = {}  # pid -> (cores, ports, Job) of a job inherited from a previous daemon
        self.seq = 0
        self.sel = selectors.DefaultSelector()
        self.log = open(LOG, "a", buffering=1)
        self.t0 = time.time()

    def logline(self, s):
        self.log.write(time.strftime("%H:%M:%S ") + s + "\n")

    # --- scheduling -----------------------------------------------------------------
    def tenant_load(self, tenant):
        return sum(len(j.cores) for j in self.running.values() if j.tenant == tenant)

    def order(self):
        return sorted(self.waiting, key=lambda j: (-j.prio, self.tenant_load(j.tenant), j.seq))

    def find_ports(self, n):
        """The lowest run of `n` consecutive pool ports under no lease and bound by nothing on
        the host, as (lo, hi); None when the pool has no such run."""
        lo, hi = self.pool
        if len(self.leased_ports) + n > hi - lo + 1:
            return None
        run = 0
        for port in range(lo, hi + 1):
            run = 0 if port in self.leased_ports or not port_free(port) else run + 1
            if run == n:
                return (port - n + 1, port)
        return None

    def lock_blocker(self, job):
        """The job that keeps `job` off its lock, or None. An exclusive taker waits for the
        exclusive holder, then for every sharer; a sharer waits for the exclusive holder, and
        for an exclusive taker already waiting (writers go first, so a stream of single boots
        cannot hold a whole bench off)."""
        if job.lock:
            if job.lock in self.locks:
                return self.locks[job.lock]
            sharers = self.shared.get(job.lock)
            return min(sharers, key=lambda j: j.t_start) if sharers else None
        if job.share:
            if job.share in self.locks:
                return self.locks[job.share]
            for j in self.order():
                if j is not job and j.lock == job.share:
                    return j
        return None

    def held(self, job):
        """What a job waits on besides cores: its lock, or ports the pool cannot give now."""
        if self.lock_blocker(job) is not None:
            return True
        return job.want_ports > 0 and self.find_ports(job.want_ports) is None

    def fits(self, job):
        if self.held(job):
            return False
        if job.quiet:
            return self.quiet_busy is None and bool(self.quiet_set)
        return len(self.free) >= min(job.want, len(self.general))

    def over_share(self, job):
        """While another tenant waits, no tenant grows past half the general cores."""
        others = any(j.tenant != job.tenant and not j.quiet for j in self.waiting)
        if not others:
            return False
        return self.tenant_load(job.tenant) + min(job.want, len(self.general)) > len(self.general) // 2

    def schedule(self):
        now = time.time()
        blocked_general = False
        for job in self.order():
            if job.quiet:
                if self.fits(job):
                    self.start(job, list(self.quiet_set))
                continue
            if blocked_general:
                continue
            if self.over_share(job):
                continue
            if self.fits(job):
                n = min(job.want, len(self.general))
                cores = sorted(self.free)[:n]
                self.start(job, cores)
            elif not self.held(job) and now - job.t_in > STARVE_S:
                # the head job has waited long enough: it takes what is free if that is at
                # least half its ask (a build or a test suite only runs slower), else the
                # free cores are held for it and nothing smaller starts
                want = min(job.want, len(self.general))
                floor = max(1, want // 2) if now - job.t_in < 3 * STARVE_S else 1
                if len(self.free) >= floor:
                    self.start(job, sorted(self.free))
                else:
                    blocked_general = True
        for job in list(self.waiting):
            # One line to a job held on a lock, naming who holds it (or waits ahead of it) and
            # since when, so a member sees why its boot has not started.
            if job.told or not job.req.get("notify"):
                continue
            blocker = self.lock_blocker(job)
            if blocker is not None:
                job.told = True
                try:
                    job.conn.sendall((json.dumps({"waiting": job.lock or job.share,
                                                  "holder": blocker.holder(blocker.t_start is None)}) + "\n").encode())
                except OSError:
                    self.finish(job.conn)

    def start(self, job, cores):
        if job.want_ports:
            job.ports = self.find_ports(job.want_ports)
            if job.ports is None:
                return  # a stranger bound a port since fits() looked: the job keeps waiting
            self.leased_ports |= set(range(job.ports[0], job.ports[1] + 1))
        self.waiting.remove(job)
        job.cores = cores
        job.t_start = time.time()
        if job.quiet:
            self.quiet_busy = job
        else:
            self.free -= set(cores)
        self.take(job)
        self.running[job.conn] = job
        try:
            job.conn.sendall((json.dumps({"cores": cores, "ports": job.ports, "share": job.share}) + "\n").encode())
        except OSError:
            self.finish(job.conn)
            return
        self.logline(f"start  {job.tenant} {job.name!r} cores={fmt_cores(cores)}{job.tags}"
                     f" waited={job.t_start - job.t_in:.1f}s")

    def take(self, job):
        if job.lock:
            self.locks[job.lock] = job
        if job.share:
            self.shared.setdefault(job.share, set()).add(job)

    def release(self, job):
        if job.lock and self.locks.get(job.lock) is job:
            del self.locks[job.lock]
        if job.share and job in self.shared.get(job.share, ()):
            self.shared[job.share].discard(job)
            if not self.shared[job.share]:
                del self.shared[job.share]

    def finish(self, conn):
        job = self.running.pop(conn, None)
        if job is None:
            for j in self.waiting:
                if j.conn is conn:
                    self.waiting.remove(j)
                    self.logline(f"cancel {j.tenant} {j.name!r} after {time.time() - j.t_in:.1f}s waiting")
                    break
        else:
            if job.quiet:
                self.quiet_busy = None
            else:
                self.free |= set(job.cores)
            self.release(job)
            if job.ports:
                self.leased_ports -= set(range(job.ports[0], job.ports[1] + 1))
            self.logline(f"end    {job.tenant} {job.name!r} cores={fmt_cores(job.cores)}{job.tags}"
                         f" ran={time.time() - job.t_start:.1f}s")
        self.bufs.pop(conn, None)
        try:
            self.sel.unregister(conn)
        except Exception:
            pass
        conn.close()

    # --- protocol -------------------------------------------------------------------
    def status(self):
        now = time.time()
        lines = [f"general cores {fmt_cores(self.general)}: {len(self.free)} free ({fmt_cores(self.free)});"
                 f" quiet cores {fmt_cores(self.quiet_set)}: {'busy' if self.quiet_busy else 'free'};"
                 f" ports {self.pool[0]}-{self.pool[1]}: {len(self.leased_ports)} leased;"
                 f" up {int(now - self.t0)}s"]
        if self.adopted:
            lines.append(f"adopted from the previous daemon: {len(self.adopted)} jobs on "
                         f"{fmt_cores(c for cs, _, _ in self.adopted.values() for c in cs)}"
                         f"{', ports ' + fmt_cores(p for _, ps, _ in self.adopted.values() for p in ps) if any(ps for _, ps, _ in self.adopted.values()) else ''}")
        lines.append(f"running {len(self.running)}:")
        for j in sorted(self.running.values(), key=lambda j: j.t_start):
            lines.append(f"  {fmt_cores(j.cores):>6}  {int(now - j.t_start):>5}s  {j.tenant:<18} {j.name}"
                         f"{'  ' + j.tags.strip() if j.tags else ''}")
        lines.append(f"waiting {len(self.waiting)}:")
        for j in self.order():
            lines.append(f"  want {j.want:>2}  {int(now - j.t_in):>5}s  p{j.prio} {j.tenant:<18} {j.name}"
                         f"{'  [quiet]' if j.quiet else ''}{'  lock=' + j.lock if j.lock else ''}"
                         f"{'  share=' + j.share if j.share else ''}"
                         f"{'  ports=%d' % j.want_ports if j.want_ports else ''}")
        for name in sorted(set(self.locks) | set(self.shared)):
            if name in self.locks:
                h = self.locks[name]
                lines.append(f"lock {name}: held by {h.tenant} {h.name!r} ({h.req.get('cwd') or '?'})"
                             f" since {time.strftime('%H:%M:%S', time.localtime(h.t_start))}"
                             f" ({int(now - h.t_start)}s)")
            else:
                lines.append(f"lock {name}: shared by {len(self.shared[name])}")
        by = {}
        for j in self.running.values():
            r = by.setdefault(j.tenant, [0, 0, 0, 0])
            r[0] += 1
            r[1] += len(j.cores)
        for j in self.waiting:
            r = by.setdefault(j.tenant, [0, 0, 0, 0])
            r[2] += 1
            r[3] += j.want
        lines.append("by tenant (running jobs/cores, waiting jobs/cores wanted):")
        for t, (rj, rc, wj, wc) in sorted(by.items(), key=lambda kv: (-kv[1][2], kv[0])):
            lines.append(f"  {t:<18} running {rj:>2}/{rc:>3}   waiting {wj:>2}/{wc:>3}")
        return "\n".join(lines) + "\n"

    def handle(self, conn):
        try:
            data = conn.recv(65536)
        except OSError:
            data = b""
        if not data:
            self.finish(conn)
            return
        buf = self.bufs.get(conn, b"") + data
        if b"\n" not in buf:
            self.bufs[conn] = buf
            return
        line, _, rest = buf.partition(b"\n")
        self.bufs[conn] = rest
        try:
            req = json.loads(line)
        except ValueError:
            self.finish(conn)
            return
        op = req.get("op")
        if op == "run":
            self.seq += 1
            self.waiting.append(Job(conn, req, self.seq))
        elif op == "ls":
            try:
                conn.sendall(self.status().encode())
            except OSError:
                pass
            self.finish(conn)
        elif op == "ping":
            try:
                conn.sendall(b"ok\n")
            except OSError:
                pass
            self.finish(conn)
        elif op == "stop":
            try:
                conn.sendall(b"stopping\n")
            except OSError:
                pass
            self.finish(conn)
            raise SystemExit(0)
        else:
            self.finish(conn)

    def adopt(self):
        """Mark the cores, ports and locks of jobs still running under a previous daemon as busy
        until they exit: the children of every `q run` client, by their CPU affinity (taskset
        execs the command, so the pin is read from /proc, not from a cmdline) and the
        REDOUBT_PORTS, Q_LOCK and Q_SHARE in their environment (the client sets them for the
        command, so they are the lease's); a lock-only job has no pin and is known by its lock."""
        import glob
        runners = set()
        for pid_dir in glob.glob("/proc/[0-9]*"):
            try:
                with open(pid_dir + "/cmdline", "rb") as f:
                    argv = f.read().split(b"\0")
            except OSError:
                continue
            if len(argv) >= 3 and (argv[1].endswith(b"/q") or argv[1] == b"q") and argv[2] == b"run":
                runners.add(int(pid_dir.rsplit("/", 1)[1]))
        if not runners:
            return
        for pid_dir in glob.glob("/proc/[0-9]*"):
            try:
                with open(pid_dir + "/stat") as f:
                    ppid = int(f.read().split(")")[-1].split()[1])
                if ppid not in runners:
                    continue
                with open(pid_dir + "/status") as f:
                    allowed = [l for l in f if l.startswith("Cpus_allowed_list:")][0].split(":")[1].strip()
                with open(pid_dir + "/cmdline", "rb") as f:
                    argv = f.read().split(b"\0")
            except (OSError, ValueError, IndexError):
                continue
            cores = [c for c in parse_cores(allowed) if c in self.general]
            if len(cores) == len(self.general):
                cores = []  # the whole machine: no pin of ours
            # The ports and locks are best effort: another user's environ is unreadable, and its
            # cores are still adopted (a job of another user holds no pool port or lock of ours).
            try:
                with open(pid_dir + "/environ", "rb") as f:
                    env = dict(kv.split(b"=", 1) for kv in f.read().split(b"\0") if b"=" in kv)
            except (OSError, ValueError):
                env = {}
            if env.get(b"REDOUBT_Q", SOCK.encode()).decode(errors="replace") != SOCK:
                continue  # a client of another daemon (a q-test's, on a socket of its own)
            lock = env.get(b"Q_LOCK", b"").decode(errors="replace") or None
            share = env.get(b"Q_SHARE", b"").decode(errors="replace") or None
            if not cores and not lock and not share:
                continue  # unpinned and holding nothing: not one of ours
            leased = parse_range(env.get(b"REDOUBT_PORTS", b"").decode(errors="replace"))
            ports = [p for p in range(leased[0], leased[1] + 1) if self.pool[0] <= p <= self.pool[1]] if leased else []
            pid = int(pid_dir.rsplit("/", 1)[1])
            # The hold is recorded as a job of its own, so a waiting job's line can name it: its
            # cwd and name from /proc, its start from the process's.
            try:
                cwd = os.readlink(pid_dir + "/cwd")
            except OSError:
                cwd = "?"
            job = Job(None, {"name": b" ".join(a for a in argv[:3] if a).decode(errors="replace")[:60], "cwd": cwd,
                             "tenant": default_tenant(cwd), "lock": lock, "share": share}, 0)
            job.t_start = process_start(pid)
            self.free -= set(cores)
            self.leased_ports |= set(ports)
            self.take(job)
            self.adopted[pid] = (cores, ports, job)
            self.logline(f"adopt  pid {pid} cores={fmt_cores(cores)}{' ports=' + fmt_cores(ports) if ports else ''}"
                         f"{' lock=' + lock if lock else ''}{' share=' + share if share else ''} {job.name!r}")

    def reap_adopted(self):
        for pid, (cores, ports, job) in list(self.adopted.items()):
            if not os.path.exists(f"/proc/{pid}"):
                self.free |= set(cores)
                self.leased_ports -= set(ports)
                self.release(job)
                del self.adopted[pid]
                self.logline(f"freed  pid {pid} cores={fmt_cores(cores)}{' ports=' + fmt_cores(ports) if ports else ''}"
                             f" (adopted job ended)")

    def serve(self):
        if os.path.exists(SOCK):
            try:
                probe = socket.socket(socket.AF_UNIX)
                probe.settimeout(1)
                probe.connect(SOCK)
                probe.sendall(b'{"op":"ping"}\n')
                if probe.recv(16).startswith(b"ok"):
                    print(f"a daemon already answers on {SOCK}", file=sys.stderr)
                    return 1
            except OSError:
                pass
            os.unlink(SOCK)
        srv = socket.socket(socket.AF_UNIX)
        srv.bind(SOCK)
        os.chmod(SOCK, 0o600)
        srv.listen(256)
        srv.setblocking(False)
        self.sel.register(srv, selectors.EVENT_READ, "srv")
        self.logline(f"daemon general={fmt_cores(self.general)} quiet={fmt_cores(self.quiet_set)}"
                     f" ports={self.pool[0]}-{self.pool[1]}")
        self.adopt()
        def on_term(*_):
            raise SystemExit(0)

        signal.signal(signal.SIGTERM, on_term)
        try:
            while True:
                for key, _ in self.sel.select(timeout=1.0):
                    if key.data == "srv":
                        conn, _ = srv.accept()
                        conn.setblocking(False)
                        self.sel.register(conn, selectors.EVENT_READ, "conn")
                    else:
                        self.handle(key.fileobj)
                if self.adopted:
                    self.reap_adopted()
                self.schedule()
        finally:
            self.logline("daemon stop")
            try:
                os.unlink(SOCK)
            except OSError:
                pass
        return 0


# ----------------------------------------------------------------------------- client


def connect():
    s = socket.socket(socket.AF_UNIX)
    s.connect(SOCK)
    return s


def default_tenant(cwd):
    # the worktree's name, or the repo root's
    parts = cwd.rstrip("/").split("/")
    if ".worktrees" in parts:
        i = parts.index(".worktrees")
        if i + 1 < len(parts):
            return parts[i + 1]
    return parts[-1] if parts else "?"


def cmd_run(a, cmd):
    if not cmd:
        print("q run: no command", file=sys.stderr)
        return 2
    cwd = os.getcwd()
    if a.lock and a.share:
        print("q run: --lock and --share name one lock each way; take it one way", file=sys.stderr)
        return 2
    req = {"op": "run", "cores": a.cores, "quiet": a.quiet, "lock": a.lock, "share": a.share,
           "ports": a.ports, "prio": a.prio, "tenant": a.tenant or default_tenant(cwd), "name": a.name,
           "pid": os.getpid(), "cwd": cwd, "cmd": cmd, "notify": True}
    # A lease request survives a daemon restart: resubmit until one answers (up to RETRY_S).
    deadline = time.time() + RETRY_S
    lease = None
    while lease is None:
        try:
            s = connect()
            s.sendall((json.dumps(req) + "\n").encode())
            buf = b""
            while lease is None:
                while b"\n" not in buf:
                    chunk = s.recv(4096)
                    if not chunk:
                        raise ConnectionResetError("the daemon went away before the lease")
                    buf += chunk
                line, _, buf = buf.partition(b"\n")
                msg = json.loads(line)
                if "cores" in msg:
                    lease = msg
                elif "waiting" in msg:
                    # Held on a lock: the one line saying by whom and since when.
                    h = msg["holder"]
                    since = time.strftime("%H:%M:%S", time.localtime(h["since"]))
                    ago = int(time.time() - h["since"])
                    print(f"q: {a.name or 'the job'} waits for the {msg['waiting']} lock: "
                          f"{h['tenant']} {h['name']!r} ({h['cwd']}) has "
                          f"{'waited for it' if h['waiting'] else 'held it'} since {since}"
                          f" ({ago // 60} min {ago % 60} s); it runs when the lock is free", file=sys.stderr)
        except OSError as e:
            if time.time() > deadline:
                print(f"q: no daemon at {SOCK} ({e}); start one with `q daemon`", file=sys.stderr)
                return 3
            time.sleep(2)
        if lease is not None and a.ports and "ports" not in lease and req["lock"] != PORT_LOCK:
            # A daemon from before --ports: give the lease back and take the old rule's lock,
            # so the job still runs apart from every other [net] boot.
            print(f"q: the daemon at {SOCK} leases no ports; running {a.name or 'the job'} under"
                  f" --lock {PORT_LOCK} instead (restart the daemon: `q stop`, `q daemon`)", file=sys.stderr)
            s.close()
            req["lock"] = PORT_LOCK
            lease = None
    if a.share and "share" not in lease:
        # A daemon from before --share knows no shared take: the job runs beside whatever runs,
        # as before the lock, and says so.
        print(f"q: the daemon at {SOCK} knows no shared lock; running {a.name or 'the job'} without"
              f" --share {a.share} (restart the daemon: `q stop`, `q daemon`)", file=sys.stderr)
    cores = lease["cores"]
    n = len(cores)
    env = dict(os.environ)
    for k in ("MAKEFLAGS", "MFLAGS", "MAKELEVEL", "CARGO_MAKEFLAGS"):
        env.pop(k, None)
    env["CARGO_BUILD_JOBS"] = str(max(1, n))
    env["RUST_TEST_THREADS"] = str(max(1, n))
    env["Q_CORES"] = fmt_cores(cores)
    # The daemon this lease is from, so only a restart of THIS daemon adopts the job (a test
    # daemon never adopts a machine boot as its sharer), and the lock the lease holds; never a
    # parent lease's.
    env["REDOUBT_Q"] = SOCK
    for k, v in (("Q_LOCK", a.lock), ("Q_SHARE", a.share)):
        if v:
            env[k] = v
        else:
            env.pop(k, None)
    if lease.get("ports"):
        env["REDOUBT_PORTS"] = "%d-%d" % tuple(lease["ports"])
    else:
        env.pop("REDOUBT_PORTS", None)  # never a parent lease's range: that one is in use
    scratch = os.environ.get("REDOUBT_TMP") or os.path.join(
        os.path.dirname(os.path.dirname(os.path.realpath(__file__))), ".tmp")
    os.makedirs(scratch, exist_ok=True)
    env["REDOUBT_TMP"] = scratch
    env["TMPDIR"] = scratch
    # A lock-only lease (--cores 0) pins nothing: the command is the hold, not work.
    argv = (["taskset", "-c", ",".join(map(str, cores))] if cores else []) + cmd
    # Keep the socket open for the whole run: the lease is the connection. The command runs
    # in a process group of its own, so a signal to this client ends everything it started
    # (a bench's QEMU and test binaries included), never leaving orphans on freed cores.
    child = subprocess.Popen(argv, env=env, start_new_session=True)

    def relay(sig, _):
        try:
            os.killpg(child.pid, sig)
        except OSError:
            pass

    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, relay)
    rc = child.wait()
    try:
        os.killpg(child.pid, signal.SIGTERM)  # stragglers the command left behind
    except OSError:
        pass
    s.close()
    return rc


def cmd_simple(op):
    try:
        s = connect()
    except OSError as e:
        print(f"q: no daemon at {SOCK} ({e})", file=sys.stderr)
        return 3
    s.sendall((json.dumps({"op": op}) + "\n").encode())
    out = b""
    while True:
        chunk = s.recv(65536)
        if not chunk:
            break
        out += chunk
    sys.stdout.write(out.decode())
    return 0


def cmd_log(n):
    try:
        with open(LOG) as f:
            lines = f.readlines()
    except OSError:
        return 0
    sys.stdout.writelines(lines[-n:])
    return 0


def main():
    argv = sys.argv[1:]
    if not argv:
        print(__doc__)
        return 2
    sub = argv[0]
    if sub == "daemon":
        p = argparse.ArgumentParser(prog="q daemon")
        p.add_argument("--cores", default=f"0-{os.cpu_count() - 1}")
        p.add_argument("--quiet", default=None, help="the quiet core set (default: the last four; '' for none)")
        p.add_argument("--ports", default=PORTS)
        a = p.parse_args(argv[1:])
        all_cores = parse_cores(a.cores)
        quiet = parse_cores(a.quiet) if a.quiet is not None else all_cores[-4:]
        ports = parse_range(a.ports)
        if ports is None:
            print(f"q daemon: --ports wants lo-hi, not {a.ports!r}", file=sys.stderr)
            return 2
        return Daemon(all_cores, quiet, ports).serve()
    if sub == "run":
        rest = argv[1:]
        cmd = []
        if "--" in rest:
            i = rest.index("--")
            rest, cmd = rest[:i], rest[i + 1:]
        p = argparse.ArgumentParser(prog="q run")
        p.add_argument("--cores", type=int, default=1)
        p.add_argument("--quiet", action="store_true")
        p.add_argument("--lock", default=None)
        p.add_argument("--share", default=None)
        p.add_argument("--ports", type=int, default=0)
        p.add_argument("--prio", type=int, default=int(os.environ.get("Q_PRIO", "5")))
        p.add_argument("--tenant", default=None)
        p.add_argument("--name", default=None)
        a = p.parse_args(rest)
        return cmd_run(a, cmd)
    if sub in ("ls", "ping", "stop"):
        return cmd_simple(sub)
    if sub == "log":
        return cmd_log(int(argv[1]) if len(argv) > 1 else 30)
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main())
