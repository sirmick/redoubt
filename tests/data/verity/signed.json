{
  "devices": [
    {"name": "uart0", "base": "268435456", "irq": 10, "dma": false},
    {"name": "disk0", "base": "268468224", "irq": 8, "dma": true}
  ],
  "volumes": [
    {"name": "data", "partition": 0, "verity": {"server": "verity:data", "key": "bundle", "floor": "2"}}
  ],
  "servers": [
    {
      "name": "keyd",
      "program": "keyd",
      "budget": {"pages": "256", "processes": 1, "weight": 100},
      "receives": ["keyd"],
      "args": ["host,ssh_host,1111111111111111111111111111111111111111111111111111111111111111", "buckets=4"]
    },
    {
      "name": "consoled",
      "program": "consoled",
      "budget": {"pages": "1024", "processes": 1, "weight": 1000},
      "devices": [{"device": "uart0", "as": "uart"}],
      "receives": ["consoled"],
      "args": ["buckets=4"]
    },
    {
      "name": "blkd",
      "program": "blkd",
      "budget": {"pages": "512", "processes": 1, "weight": 1000},
      "devices": [{"device": "disk0", "as": "disk"}],
      "receives": ["blkd"], "args": ["endpoint=blkd"]
    },
    {
      "name": "verity:data",
      "program": "verityd",
      "stack_pages": "5", "heap_pages": "94",
      "budget": {"pages": "256", "processes": 1, "weight": 100},
      "receives": ["verity:data"]
    },
    {
      "name": "littlefsd",
      "program": "littlefsd",
      "budget": {"pages": "1024", "processes": 1, "weight": 100},
      "volume": "data",
      "receives": ["littlefsd:data"],
      "args": ["endpoint=littlefsd:data", "buckets=4"]
    },
    {
      "name": "client",
      "program": "littlefsd-client",
      "budget": {"pages": "256", "processes": 1, "weight": 100},
      "handed": [{"endpoint": "littlefsd:data", "badge": "7"}],
      "args": ["read", "littlefsd:data", "/motd", "Redoubt, from the image disk\n", "/etc/notes", "staged under etc\n"]
    }
  ]
}
