{
  "devices": [
    { "name": "uart0", "base": "268435456", "irq": 10, "dma": false },
    { "name": "disk0", "base": "268468224", "irq": 8, "dma": true },
    { "name": "disk1", "base": "268460032", "irq": 6, "dma": true },
    { "name": "net0", "base": "268464128", "irq": 7, "dma": true }
  ],
  "volumes": [
    { "name": "data", "partition": 0, "disk": "blkd" },
    { "name": "system", "partition": 0, "disk": "blkd:system" }
  ],
  "servers": [
    { "name": "keyd", "program": "keyd",
      "stack_pages": "3", "heap_pages": "8",
      "budget": { "pages": "256", "processes": 1, "weight": 100 },
      "receives": ["keyd"],
      "args": ["host,ssh_host,1111111111111111111111111111111111111111111111111111111111111111",
               "audit,audit,2222222222222222222222222222222222222222222222222222222222222222",
               "buckets=4"] },
    { "name": "consoled", "program": "consoled",
      "stack_pages": "5", "heap_pages": "18",
      "budget": { "pages": "1024", "processes": 1, "weight": 1000 },
      "devices": [ { "device": "uart0", "as": "uart" } ],
      "receives": ["consoled"],
      "args": ["buckets=4"] },
    { "name": "bootfsd", "program": "bootfsd",
      "stack_pages": "4", "heap_pages": "56",
      "budget": { "pages": "640", "processes": 1, "weight": 100 },
      "receives": ["bootfsd"],
      "args": ["buckets=4"] },
    { "name": "blkd", "program": "blkd",
      "stack_pages": "3", "heap_pages": "34",
      "budget": { "pages": "512", "processes": 1, "weight": 1000 },
      "devices": [ { "device": "disk0", "as": "disk" } ],
      "receives": ["blkd"], "args": ["endpoint=blkd"] },
    { "name": "netd", "program": "netd",
      "stack_pages": "3", "heap_pages": "4",
      "budget": { "pages": "1024", "processes": 1, "weight": 1000 },
      "devices": [ { "device": "net0", "as": "net" } ],
      "receives": ["netd"],
      "handed": [ { "endpoint": "ipd", "badge": "3" } ],
      "args": ["client=5"] },
    { "name": "ipd", "program": "ipd",
      "stack_pages": "4", "heap_pages": "8",
      "budget": { "pages": "4096", "processes": 1, "weight": 100 },
      "receives": ["ipd"],
      "handed": [ { "endpoint": "netd", "badge": "5" } ],
      "args": ["addr=10.0.2.15/24", "gateway=10.0.2.2", "ingress=3",
               "scope=4:c:0.0.0.0/0:1-65535", "buckets=4"] },
    { "name": "littlefsd:data", "program": "littlefsd",
      "stack_pages": "4", "heap_pages": "18",
      "budget": { "pages": "1024", "processes": 1, "weight": 100 },
      "volume": "data",
      "receives": ["littlefsd:data"],
      "args": ["endpoint=littlefsd:data", "buckets=4"] },
    { "name": "blkd:system", "program": "blkd",
      "stack_pages": "3", "heap_pages": "34",
      "budget": { "pages": "512", "processes": 1, "weight": 1000 },
      "devices": [ { "device": "disk1", "as": "disk" } ],
      "receives": ["blkd:system"], "args": ["endpoint=blkd:system"] },
    { "name": "erofsd:system", "program": "erofsd",
      "stack_pages": "5", "heap_pages": "24",
      "budget": { "pages": "1024", "processes": 1, "weight": 100 },
      "volume": "system",
      "receives": ["erofsd:system"],
      "args": ["endpoint=erofsd:system", "buckets=4"] },
    { "name": "beamlet", "program": "beamlet",
      "stack_pages": "17", "heap_pages": "20846",
      "budget": { "pages": "20864", "processes": 1, "weight": 100 },
      "handed": [ { "endpoint": "erofsd:system", "badge": "7" } ],
      "args": ["budget_pages=20864", "endpoint=erofsd:system", "Elixir.Redoubt.Shell"] }
  ]
