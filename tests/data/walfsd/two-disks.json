{
  "devices": [
    {"name": "uart0", "base": "268435456", "irq": 10, "dma": false},
    {"name": "disk0", "base": "268468224", "irq": 8, "dma": true},
    {"name": "disk2", "base": "268455936", "irq": 5, "dma": true}
  ],
  "volumes": [
    {"name": "data", "partition": 0, "disk": "blkd:data"},
    {"name": "vault", "partition": 0, "disk": "blkd:vault"}
  ],
  "servers": [
    {
      "name": "keyd",
      "program": "keyd",
      "budget": {"pages": "256", "processes": 1, "weight": 100},
      "receives": ["keyd"],
      "args": ["host,ssh_host,1111111111111111111111111111111111111111111111111111111111111111", "buckets=4"]
    },
    {
      "name": "consoled",
      "program": "consoled",
      "budget": {"pages": "1024", "processes": 1, "weight": 1000},
      "devices": [{"device": "uart0", "as": "uart"}],
      "receives": ["consoled"],
      "args": ["buckets=4"]
    },
    {
      "name": "blkd:data",
      "program": "blkd",
      "budget": {"pages": "512", "processes": 1, "weight": 1000},
      "devices": [{"device": "disk0", "as": "disk"}],
      "receives": ["blkd:data"], "args": ["endpoint=blkd:data"]
    },
    {
      "name": "blkd:vault",
      "program": "blkd",
      "budget": {"pages": "512", "processes": 1, "weight": 1000},
      "devices": [{"device": "disk2", "as": "disk"}],
      "receives": ["blkd:vault"], "args": ["endpoint=blkd:vault"]
    },
    {
      "name": "walfsd:data",
      "program": "walfsd",
      "budget": {"pages": "1280", "processes": 1, "weight": 100},
      "volume": "data",
      "receives": ["walfsd:data"],
      "args": ["endpoint=walfsd:data", "buckets=4"]
    },
    {
      "name": "walfsd:vault",
      "program": "walfsd",
      "budget": {"pages": "1280", "processes": 1, "weight": 100},
      "volume": "vault",
      "receives": ["walfsd:vault"],
      "args": ["endpoint=walfsd:vault", "buckets=4"]
    },
    {
      "name": "client",
      "program": "littlefsd-client",
      "budget": {"pages": "256", "processes": 1, "weight": 100},
      "handed": [{"endpoint": "walfsd:data", "badge": "7"}, {"endpoint": "walfsd:vault", "badge": "7"}],
      "args": ["boot", "walfsd:data", "walfsd:vault"]
    }
  ]
}
