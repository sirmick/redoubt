#!/usr/bin/env bash
# Differential test: every tests/<suite>/*.erl is compiled with the pinned erlc, run on the real
# BEAM (the oracle) and on beamlet, and the two results must be identical.
#
#   tools/difftest [SUITE...]      default: every directory under tests/
#
# Results go to build/difftest/<suite>/. Exit status is non-zero if any test differs.
# tests/<suite>/SKIP lists modules that test features left out by design, with the reason.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
. "$root/tools/env.sh"
otp_lib="$(dirname "$(dirname "$(command -v erl)")")/lib"
stdlib=( "$otp_lib"/stdlib-*/ebin )
cryptolib=( "$otp_lib"/crypto-*/ebin )
publickeylib=( "$otp_lib"/public_key-*/ebin )
asn1lib=( "$otp_lib"/asn1-*/ebin )
elixir_lib="$(dirname "$(dirname "$(command -v elixir)")")/lib"
elixir_ebin="$elixir_lib/elixir/ebin"
"$root/tools/build-lib" --check
cargo build --quiet --release --manifest-path "$root/Cargo.toml" -p beamlet
beamlet="$root/target/release/beamlet"
timeout_s="${DIFFTEST_TIMEOUT:-10}"

suites=("$@")
if [ ${#suites[@]} -eq 0 ]; then
    for d in "$root"/tests/*/; do suites+=("$(basename "$d")"); done
fi

total=0; pass=0; fail=0; skip=0; failed=()
for suite in "${suites[@]}"; do
    src="$root/tests/$suite"; out="$root/build/difftest/$suite"
    mkdir -p "$out"
    # Recompile (and re-run the oracle) only when sources changed.
    stamp="$out/.stamp"
    if [ ! -f "$stamp" ] || [ -n "$(find "$src" \( -name '*.erl' -o -name '*.ex' -o -name SKIP \) -newer "$stamp" -print -quit)" ]; then
        rm -f "$out"/*.beam "$out"/*.expected
        : > "$out/erlc.log"
        shopt -s nullglob
        for f in "$src"/*.erl; do erlc -o "$out" "$f" 2>> "$out/erlc.log" || echo "erlc failed: $f" >> "$out/erlc.log"; done
        for f in "$src"/*.ex; do elixirc -o "$out" "$f" >> "$out/erlc.log" 2>&1 || echo "elixirc failed: $f" >> "$out/erlc.log"; done
        # Only top-level test modules have start/0; nested modules (structs) are not tests.
        # UTC: beamlet has no time zone, so localtime() is universaltime().
        TZ=UTC ERL_LIBS="$elixir_lib" escript "$root/tools/expect.escript" "$out"
        touch "$stamp"
    fi
    shopt -s nullglob
    for exp in "$out"/*.expected; do
        m="$(basename "$exp" .expected)"
        if [ -f "$src/SKIP" ] && grep -qE "^$m[[:space:]]" "$src/SKIP"; then
            skip=$((skip + 1)); continue
        fi
        total=$((total + 1))
        got="$(timeout "$timeout_s" "$beamlet" -pa "$out" -pa "${stdlib[0]}" -pa "${cryptolib[0]}" -pa "${publickeylib[0]}" -pa "${asn1lib[0]}" -pa "$elixir_ebin" "$m" 2>&1 || echo "EXIT $?")"
        printf '%s\n' "$got" > "$out/$m.got"
        # The result is the last line; anything before it is the program's own console output.
        if [ "$(printf '%s\n' "$got" | tail -n 1)" == "$(cat "$exp")" ]; then
            pass=$((pass + 1))
        else
            fail=$((fail + 1)); failed+=("$suite/$m")
        fi
    done
done
for f in "${failed[@]}"; do
    s="${f%%/*}"; m="${f#*/}"
    printf 'FAIL %s\n' "$f"
    escript "$root/tools/termdiff.escript" "$root/build/difftest/$s/$m.expected" "$root/build/difftest/$s/$m.got" 2>&1 | head -40
done
echo "difftest: $pass/$total passed, $fail failed, $skip skipped by design"
[ "$fail" -eq 0 ]
