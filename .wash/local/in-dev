#!/usr/bin/env bash
# in-dev -- run one command inside the dev container, in the caller's current directory.
#
# Every cargo, bench and mdbook command may run in the image dev.sh builds, or natively after
# scripts/setup.sh (TOOL1, 2026-10-05): the two are the same toolchain. dev.sh mounts the main
# checkout at /work and at its own host path, so a worktree's .git file resolves without any
# link, and git works from any worktree. The firmware is the main checkout's, which a worktree
# does not build.
#
#   .wash/local/in-dev cargo testbench --arch rv64 redoubt-ipc
#   .wash/local/in-dev cargo +nightly fmt --all --check
#
# The first run after TOOL1's merge rebuilds the image (IMAGE_REV 5: setup.sh --with-beam, OTP
# from source, some minutes).
set -euo pipefail
ROOT=/home/mcloonan/redoubt
exec "$ROOT/dev.sh" bash -c '
    export RUSTSBI_PROTOTYPER="$1/bios/target/riscv64gc-unknown-none-elf/release/rustsbi-prototyper"
    export RUSTSBI_PROTOTYPER_RV32="$1/bios/target/riscv32imac-unknown-none-elf/release/rustsbi-prototyper"
    cd "$2" && shift 2 && exec "$@"
' _ "$ROOT" "$PWD" "$@"
