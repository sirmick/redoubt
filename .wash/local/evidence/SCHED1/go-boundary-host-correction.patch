+#[derive(Clone, Copy)]
+struct ClusterSample {
+    intent_positive: bool,
+    prep_us: i64,
+    arm: u64,
+    deadline: u64,
+    service: u64,
+    delay_us: u64,
+    service_now_us: u64,
+}
