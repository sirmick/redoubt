+        }
+        let mut picks = 0usize;
+        let mut peer_r10_overlap_us = 0u64;
+        let mut net = Vec::new();
+        let mut category_net = [Vec::new(), Vec::new()];
+        let mut details = Vec::new();
+        for (sample_index, (&w, &(sample_end, gross))) in
