+    fn timeout_wake_proof_rejects_preemption_and_an_unframed_wake() {
+        let events = [
+            ('K', 7, 0),
+            ('I', 7, 100),
+            ('E', 8, 1),
+            ('W', 8, 10),
+            ('O', 0, 1),
