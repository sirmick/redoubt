+/// Metadata is sent in original attempt order after measurement. The clock unit is explicit:
+/// goldfish RTC nanoseconds for the driver, `time_now` microseconds for the timer.
+fn cluster_metadata(log: &str) -> Result<[Vec<ClusterSample>; 2], String> {
+    let mut out = [Vec::new(), Vec::new()];
+    for line in log.lines().map(|x| x.trim_end_matches('\r')) {
+        let Some(rest) = line.strip_prefix("CLUSTER-SAMPLE ") else { continue };
+        let f: Vec<_> = rest.split_whitespace().collect();
+        let bad = || format!("malformed cluster metadata {line:?}");
+        if f.len() != 11 {
+            return Err(bad());
+        }
+        let (standin, unit) = match (f[0], f[9]) {
+            ("driver_wake", "rtc_ns") => (0, 1_000u64),
+            ("timer_wake", "timer_us") => (1, 1u64),
+            _ => return Err(bad()),
+        };
+        let num = |i: usize| f[i].parse::<u64>().map_err(|_| bad());
+        let index = num(1)? as usize;
+        let intent = num(2)?;
+        let slot = num(3)?;
+        let prep_us = f[4].parse::<i64>().map_err(|_| bad())?;
+        let (arm, deadline, service, delay_us, service_now_us) =
+            (num(5)?, num(6)?, num(7)?, num(8)?, num(10)?);
+        let expected_phase = [100, 300, 600, 850][index % 4];
+        if index != out[standin].len()
+            || index >= 200
+            || intent > 1
+            || (intent == 1) != (index / 4 % 2 == 1)
+            || slot != index as u64 * 80_000
+            || (intent == 1 && prep_us < 0)
+            || delay_us == 0
+            || (intent == 1 && delay_us != expected_phase)
+            || deadline != arm.checked_add(delay_us.checked_mul(unit).ok_or_else(bad)?).ok_or_else(bad)?
+            || service < deadline
+            || (standin == 1 && service_now_us != service)
+        {
+            return Err(format!("cluster metadata order/construction failure at {line:?}"));
+        }
+        out[standin].push(ClusterSample {
+            intent_positive: intent == 1,
+            prep_us,
+            arm,
+            deadline,
+            service,
+            delay_us,
+            service_now_us,
+        });
+    }
+    if out.iter().any(|samples| samples.len() != 200) {
+        return Err(format!("cluster metadata counts {:?}, expected 200 per stand-in", out.map(|v| v.len())));
+    }
+    Ok(out)
+}
+
+/// Prove both ends of each sample on the fixed `time_now` measurement clock. The RTC has a
+/// separate epoch: its service-deadline difference is a duration, never an absolute timestamp.
+/// The existing `sample_end` precedes the RTC service read, so subtracting the rounded-up RTC
+/// duration gives a conservative lower bound on the deadline. A later `time_now` brackets service.
+fn cluster_window_bounds(
+    standin: usize,
+    release: u64,
+    end: u64,
+    sample_end: u64,
+    gross: u64,
+    meta: ClusterSample,
+) -> Result<u64, &'static str> {
+    let bad = || "window outside measurement";
+    let sample_start = sample_end.checked_sub(gross).ok_or_else(bad)?;
+    if sample_end > end {
+        return Err(bad());
+    }
+    let deadline_lower = if standin == 0 {
+        if meta.service < meta.deadline || meta.service_now_us < sample_end || meta.service_now_us > end {
+            return Err(bad());
+        }
+        let rtc_duration_ns = meta.service.checked_sub(meta.deadline).ok_or_else(bad)?;
+        sample_end.checked_sub(rtc_duration_ns.div_ceil(1_000)).ok_or_else(bad)?
+    } else {
+        if meta.service_now_us != meta.service || sample_end != meta.service || meta.service > end {
+            return Err(bad());
+        }
+        meta.deadline
+    };
+    if deadline_lower < release || sample_start < release {
+        return Err(bad());
+    }
+    Ok(sample_start)
+}
