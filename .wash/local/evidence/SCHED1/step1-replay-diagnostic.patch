+//! SCHED1 step-1 host replay (not committed): judge a saved cluster console with the oracle.
+#[path = "../src/sched_oracle.rs"]
+#[allow(dead_code)]
+mod sched_oracle;
+
+#[test]
+#[ignore]
+fn replay_saved_cluster_log() {
+    let path = std::env::var("SCHED1_REPLAY_LOG").expect("SCHED1_REPLAY_LOG names the console log");
+    let log = std::fs::read_to_string(&path).expect("the saved console log");
+    let args = "cluster driver_wake_p50_us=15000 driver_wake_p99_us=50000 timer_wake_p50_us=15000 \
+                timer_wake_p99_us=50000";
+    match sched_oracle::run(&log, args) {
+        Ok(report) => println!("ORACLE PASS\n{report}"),
+        Err(why) => println!("ORACLE FAIL\n{why}"),
+    }
+}
