diff --git a/kernel/src/kcount.rs b/kernel/src/kcount.rs
new file mode 100644
index 000000000..fb57519b3
--- /dev/null
+++ b/kernel/src/kcount.rs
@@ -0,0 +1,64 @@
+//! LOCAL INSTRUMENT, never committed (ASID1's cost trace): time in user mode, in the kernel and
+//! idle in `wfi`, in `time` ticks, and the `sfence.vma`s run, printed at every `time_now`.
+
+use crate::cell::KernelCell;
+
+#[derive(Default)]
+struct Counts {
+    since: usize,
+    in_user: bool,
+    user: u64,
+    kernel: u64,
+    idle: u64,
+    sfence: u64,
+    entries: u64,
+}
+
+static C: KernelCell<Counts> =
+    KernelCell::new(Counts { since: 0, in_user: false, user: 0, kernel: 0, idle: 0, sfence: 0, entries: 0 });
+
+fn now() -> usize { riscv::register::time::read() }
+
+/// The ticks since the open interval began; a new one starts now.
+fn close(c: &mut Counts) -> u64 {
+    let t = now();
+    let d = t.wrapping_sub(c.since) as u64;
+    c.since = t;
+    d
+}
+
+/// A trap entered the kernel.
+pub fn entry() {
+    C.with(|c| {
+        if c.in_user {
+            c.in_user = false;
+            c.user += close(c);
+            c.entries += 1;
+        }
+    })
+}
+
+/// The kernel returns, to user mode if `to_user` (else to `kmain`, which is kernel time).
+pub fn exit(to_user: bool) {
+    C.with(|c| {
+        if to_user && !c.in_user {
+            c.kernel += close(c);
+            c.in_user = true;
+        }
+    })
+}
+
+pub fn idle_begin() { C.with(|c| c.kernel += close(c)) }
+pub fn idle_end() { C.with(|c| c.idle += close(c)) }
+pub fn sfence() { C.with(|c| c.sfence += 1) }
+
+/// Print the totals so far (the caller is in the kernel).
+pub fn snapshot() {
+    let (user, kernel, idle, sfence, entries) = C.with(|c| {
+        c.kernel += close(c);
+        (c.user, c.kernel, c.idle, c.sfence, c.entries)
+    });
+    println!("[kcount] user {} kernel {} idle {} sfence {} entries {}", user, kernel, idle, sfence, entries);
+    // The print itself is not the measured window's.
+    C.with(|c| c.since = now());
+}
