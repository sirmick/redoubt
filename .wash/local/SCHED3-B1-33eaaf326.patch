+pub fn lowered((hint, by): (u64, Option<u64>), at: u64, payer: u64) -> (u64, Option<u64>) {
+    match at.cmp(&hint) {
+        core::cmp::Ordering::Less => (at, Some(payer)),
+        core::cmp::Ordering::Equal if by != Some(payer) => (hint, None),
+        _ => (hint, by),
+    }
