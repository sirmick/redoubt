+    /// longest stretch of user mode between two kernel entries: with 1 ms slices, a stretch far
+    /// past a slice means the guest did not run (its host did not run it) while its clock moved.
+    static IN_USER: AtomicBool = AtomicBool::new(false);
+    static LEFT: AtomicU32 = AtomicU32::new(0);
+    static LEFT_PID: AtomicU32 = AtomicU32::new(0);
+    static LONGEST_USER: AtomicU32 = AtomicU32::new(0);
