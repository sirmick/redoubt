+    /// The timer was armed for `us` (`u64::MAX`: for nothing).
+    pub fn armed(us: u64) {
+        ARMED_SET.store(us != u64::MAX, SeqCst);
+        ARMED.store(us as u32, SeqCst);
+    }
+    /// A wake from idle: how late it is past the armed deadline, if that has passed.
+    pub fn woke() {
+        if !ARMED_SET.load(SeqCst) {
+            return;
+        }
+        let late = now().wrapping_sub(ARMED.load(SeqCst));
+        // A wake before the deadline (another interrupt) wraps to a huge value: not a lateness.
+        if late > 1 << 31 {
+            return;
+        }
+        let worse = late > WORST_WAKE.load(SeqCst);
+        if worse {
