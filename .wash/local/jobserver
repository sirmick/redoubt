#!/bin/bash
# jobserver: one pool of work tokens for the whole machine, shared by every `make` and every
# cargo/rustc under it (GNU make's named-fifo jobserver, make >= 4.4).
#
#   jobserver init [N]      create the fifo with N tokens (default: nproc) and its holder; idempotent
#   jobserver stop          end the holder and remove the fifo (every token with it)
#   jobserver env           print the export line a shell needs to join the pool
#   jobserver take <cmd...> shared work, taking one extra token if one is free (a QEMU guest is a
#                           second busy core beside the make job that runs it); never waits for it
#   jobserver share <cmd..> shared work with no extra token (a build; cargo takes its own)
#   jobserver net <cmd...>  a [net] boot: shared, but one at a time among [net] cases (ports)
#   jobserver bounded <cmd> a host-tests case without wall-clock asserts: shared, test threads
#                           held to BOUNDED_THREADS (default 4)
#   jobserver all <cmd...>  exclusive work: waits for every shared job to finish and keeps new
#                           ones from starting (host-clock cases: docs/testbench.md "On a
#                           shared host"); plain cargo must go through `share` to be seen
#   jobserver free          how many tokens are unclaimed right now
#   jobserver reset         when nothing runs: drain and refill to exactly N (after a leak)
#
# A token is one byte in the fifo. make and cargo take one per running job and put it back
# when the job ends; a killed make returns its tokens on exit. The only resident process is one
# `sleep infinity` that keeps the fifo (and so its tokens) alive.
set -eu
fifo=${REDOUBT_JOBSERVER:-/tmp/redoubt-js}
case ${1:-} in
init)
    n=${2:-$(nproc)}
    if [ -p "$fifo" ] && kill -0 "$(cat "$fifo.pid" 2>/dev/null)" 2>/dev/null; then
        echo "$fifo exists ($($0 free) tokens free, holder $(cat "$fifo.pid"))"
        exit 0
    fi
    rm -f "$fifo"
    mkfifo -m 600 "$fifo"
    # A fifo's bytes live only while some process holds it open: one sleeping holder does.
    setsid sleep infinity 3<>"$fifo" >/dev/null 2>&1 &
    echo $! > "$fifo.pid"
    exec 3<>"$fifo"
    i=0
    while [ $i -lt "$n" ]; do printf + >&3; i=$((i + 1)); done
    exec 3>&-
    echo "$n" > "$fifo.n"
    : > "$fifo.lock"
    echo "created $fifo with $n tokens (holder $(cat "$fifo.pid"))"
    ;;
stop)
    kill "$(cat "$fifo.pid" 2>/dev/null)" 2>/dev/null || true
    rm -f "$fifo" "$fifo.pid"
    echo "stopped"
    ;;
env)
    echo "export MAKEFLAGS='--jobserver-auth=fifo:$fifo --jobserver-style=fifo'"
    ;;
take)
    # shared work plus one extra token (a guest's own core); waits while an `all` runs
    shift
    exec 5>"$fifo.gate"
    flock -x 5                                # a waiting `all` holds the gate: queue behind it
    exec 4>"$fifo.lock"
    flock -s 4
    flock -u 5
    exec 5>&-
    exec 3<>"$fifo"
    tok=""
    trap 'printf "%s" "$tok" >&3' EXIT       # return only what was taken
    trap 'exit 143' INT TERM
    # Best effort, never blocking: a make-started job already holds a job token, and if the
    # pool is empty, waiting here while holding the shared lock deadlocks an exclusive job.
    IFS= read -r -t 0.05 -N 1 tok <&3 || tok=""
    "$@" & child=$!
    trap 'kill "$child" 2>/dev/null; exit 143' INT TERM
    wait "$child"
    ;;
net)
    # a [net] boot: shared on the main lock (one extra token for its guest) but exclusive among
    # [net] cases (the port race), through its own lock
    shift
    exec 6>"$fifo.net"
    flock -x 6
    exec "$0" take "$@"
    ;;
bounded)
    # a host-tests case whose crates assert no wall-clock bound: shared, with cargo test's
    # threads held to BOUNDED_THREADS (default 4) so one binary cannot oversubscribe the host
    shift
    exec env RUST_TEST_THREADS="${BOUNDED_THREADS:-4}" "$0" share "$@"
    ;;
share)
    # shared work with no extra token (a build: cargo takes its own tokens); waits for an `all`
    shift
    exec 5>"$fifo.gate"
    flock -x 5
    exec 4>"$fifo.lock"
    flock -s 4
    flock -u 5
    exec 5>&-
    exec "$@"
    ;;
all)
    # exclusive: the exclusive lock, which every `take` and `share` holds shared, so nothing
    # that went through this script runs beside it, and no sibling can start until it ends.
    # It takes no pool tokens beyond the one make gave its job: draining them would deadlock
    # with sibling make jobs that hold a token each while they wait for this lock. Plain
    # cargo outside this script is the one hole; members run it as `jobserver share cargo`.
    shift
    exec 5>"$fifo.gate"
    flock -x 5                                # close the gate: no new shared job starts
    exec 4>"$fifo.lock"
    flock -x 4                                # then wait for the running shared jobs to end
    "$@" & child=$!
    trap 'kill "$child" 2>/dev/null; exit 143' INT TERM
    wait "$child"
    ;;
reset)
    # idle only (no make, take, share or all alive): drain whatever is there and refill to N
    if pgrep -f 'jobserver (take|share|all) ' >/dev/null || pgrep -x make >/dev/null; then
        echo "reset refused: jobs are running" >&2
        exit 1
    fi
    n=$(cat "$fifo.n")
    exec 3<>"$fifo"
    had=0
    while IFS= read -r -t 1 -N 1 tok <&3; do had=$((had + 1)); done
    i=0
    while [ $i -lt "$n" ]; do printf + >&3; i=$((i + 1)); done
    echo "reset: had $had, now $n"
    ;;
free)
    # count without consuming: take tokens while one is there at once, then put them all back
    exec 3<>"$fifo"
    n=0
    while IFS= read -r -t 0.5 -N 1 tok <&3; do n=$((n + 1)); done
    i=0
    while [ $i -lt $n ]; do printf + >&3; i=$((i + 1)); done
    echo "$n"
    ;;
*)
    sed -n '2,13p' "$0" >&2
    exit 2
    ;;
esac
