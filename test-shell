#!/usr/bin/env bash
#
# test-shell -- test Redoubt's shell (userland/shell) and its native libraries (userland/native):
# the Elixir's formatting, the native crates' tests, the shell's tests on beamlet and the same
# tests on BEAM, its entry point, and beamlet's Redoubt platform, built for the machine as it
# ships and then on the fake kernel with the shell on it. Every stage runs; the exit status is
# non-zero if any failed.
#
# Usage: ./test-shell [FILE...]
#   ./test-shell                                  every stage, every test
#   ./test-shell test/redoubt/util_test.exs       these test files (in userland/shell), on both VMs
#
# The Rust's formatting needs nightly rustfmt, which the bench's formatting case runs.
# A test that passes on BEAM and fails on beamlet is a beamlet bug. The entry point is its own
# stage because ExUnit cannot reach it: its runner starts applications the shell must start for
# itself. On beamlet the VM's / is a scratch directory made afresh for each run
# (userland/shell/_build/beamlet-root), the shell's sources are mounted read-only at /src, and a
# directory on /dev/shm, another file system, is mounted at /xdev for moves across volumes; so a
# test that writes where it should not fails there, and nothing a test leaves outlives the run.
# On BEAM the tests run with this machine's own rights, each in a temporary directory of its own
# (ExUnit's, under userland/shell/tmp), its build in userland/shell/_build/test. The two VMs share
# no scratch, so they run at once, and BEAM's output is shown after beamlet's.
#
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
case "${1:-}" in -h | --help) sed -n '2,10p' "$0"; exit 0 ;; esac

. userland/shell/setup.sh
files=("$@")
if [ ${#files[@]} -eq 0 ]; then
    while IFS= read -r f; do files+=("${f#"$app/"}"); done < <(find "$app/test" -name '*_test.exs' | sort)
fi

formatting() { (cd "$app" && mix format --check-formatted); }

# The cell protocol, and the screen buffer's natives with the width table they share with OTP,
# held to the pinned OTP that generated it.
native() {
    (cd "$native" && cargo test -q) &&
        (cd "$otp" && cargo test -q -p beamlet-screen && escript tools/gen-width.escript --check)
}

on_beam() { (cd "$app" && mix test "${files[@]}"); }

on_beamlet() {
    local runner="$app/_build/beamlet-test" root="$app/_build/beamlet-root" log xdev tests=()
    rm -rf "$root"
    mkdir -p "$runner" "$root"
    [ "$runner/exunit.beam" -nt "$otp/tools/exunit.erl" ] || erlc -o "$runner" "$otp/tools/exunit.erl"
    for f in "${files[@]}"; do tests+=("/src/$f"); done
    xdev="$(mktemp -d /dev/shm/redoubt-shell-test.XXXXXX)"
    log="$(mktemp)"
    # The cells crate's vectors at /cells, read-only.
    "$beamlet" --root "$root" --mount "/src=$app:ro" --mount "/xdev=$xdev" \
        --mount "/cells=$native/cells:ro" --env CELLS_VECTORS=/cells/vectors.json "${path[@]}" -pa "$runner" \
        exunit run / /src/test/test_helper.exs "${tests[@]}" 2>&1 | tee "$log"
    # beamlet prints ExUnit's summary last: the run passed only if it counts no failures.
    tail -n 1 "$log" | grep -q 'failures => 0,'
    local passed=$?
    rm -rf "$log" "$xdev"
    return $passed
}

# Starts the shell as ./shell does, defines a module at its prompt, which needs everything the
# shell must start for itself, and lays out a table. The console is a pipe, so the driver
# echoes each line as it is entered, through the encoder, and prints each value on a line of
# its own; the carriage returns the encoder ends its lines with are dropped before the checks.
entry_point() {
    local out
    out="$(printf 'defmodule Smoke do\n  def ok, do: :smoke_ok\nend\nSmoke.ok()\ntable([["smoke", 1]])\n"a\xffb"\n1 + 1\n' |
        "$beamlet" --root "$sandbox" "${path[@]}" Elixir.Redoubt.Shell 2>&1 | tr -d '\r')"
    # A byte that is not UTF-8, straight from the console, is read as the Latin-1 character it is.
    grep -qx ':smoke_ok' <<<"$out" && grep -qx 'smoke 1' <<<"$out" &&
        grep -qx '"aÿb"' <<<"$out" && grep -qx '2' <<<"$out" || { printf '%s\n' "$out"; return 1; }
}

# beamlet's Redoubt platform (userland/otp/redoubt): built for the machine, without the fake
# kernel, as it ships; its tests; then the shell on it, as ./shell --fake runs it, its console
# reached through the client library and the fake kernel. The tests run only when what they run
# changed since they last passed here: the binaries cargo built, byte for byte, and the VM's
# fixtures they load; an Elixir-only change rebuilds none of it.
on_fake_kernel() {
    local out key stamp="$otp/target/test-shell-fake-kernel"
    (cd "$otp" && cargo build -q -p beamlet-redoubt --target riscv64imac-unknown-none-elf) || return 1
    (cd "$otp" && cargo test -q -p beamlet-redoubt --features fake --no-run) || return 1
    key="$(fake_kernel_inputs)" || return 1
    if [ "$key" = "$(cat "$stamp" 2>/dev/null)" ]; then
        echo "beamlet-redoubt's tests: skipped, nothing they run changed since they last passed"
    else
        (cd "$otp" && cargo test -q -p beamlet-redoubt --features fake) || return 1
        printf '%s\n' "$key" >"$stamp"
    fi
    out="$(printf 'x = Enum.map([1, 2], &(&1 * 10))\nEnum.sum(x)\n' | "$fake" "${path[@]}" Elixir.Redoubt.Shell 2>&1 | tr -d '\r')"
    grep -qx '\[10, 20\]' <<<"$out" && grep -qx '30' <<<"$out" || { printf '%s\n' "$out"; return 1; }
}

# One hash of what on_fake_kernel's tests run: every executable of both builds (cargo, asked
# again, builds nothing and names them) and the fixtures limits.rs loads.
fake_kernel_inputs() {
    (cd "$otp" && {
        cargo build -q -p beamlet-redoubt --target riscv64imac-unknown-none-elf --message-format=json
        cargo test -q -p beamlet-redoubt --features fake --no-run --message-format=json
    } 2>/dev/null | grep -o '"executable":"[^"]*"' | sed 's/^"executable":"//; s/"$//' | sort |
        xargs sha256sum && sha256sum vm/tests/fixtures/*) | sha256sum
}

# The shell on a pseudo-terminal: beamlet's binary, the shell's code path, and a screen taking the
# terminal and giving it back (userland/otp/cli/tests/shell_pty.rs).
terminal() {
    (cd "$otp" && SHELL_PTY_ARGS="$(printf '%s\n' --root "$sandbox" "${path[@]}")" \
        cargo test -q --release -p beamlet --test shell_pty -- --ignored)
}

set +e
failed=()
verdict() { if [ "$2" -eq 0 ]; then echo "== $1: ok"; else echo "== $1: FAILED"; failed+=("$1"); fi; }
for stage in formatting native on_vms entry_point terminal on_fake_kernel; do
    if [ "$stage" = on_vms ]; then
        beam_log="$(mktemp)"
        on_beam >"$beam_log" 2>&1 &
        beam=$!
        echo "== on_beamlet"
        on_beamlet
        verdict on_beamlet $?
        wait "$beam"
        rc=$?
        echo "== on_beam"
        cat "$beam_log"
        rm -f "$beam_log"
        verdict on_beam $rc
    else
        echo "== $stage"
        "$stage"
        verdict "$stage" $?
    fi
done
if [ ${#failed[@]} -eq 0 ]; then
    echo "test-shell: every stage passed"
else
    echo "test-shell: FAILED: ${failed[*]}"
    exit 1
fi
