# Sessions: a login refused for each reason, one started and ended each way, a failed start,
# and the events the embedder's guarantee excludes.
principal "alice" account=1 login=[11] approval=[21] owned=[7] sets=[[],[7],[8]] top=1000,30,300 contexts=2 idle=300
principal "bob" account=2 login=[12] approval=[22] owned=[] sets=[[]] top=1000,30,300 contexts=2 idle=300
keyd [31]
servers 1
sizes session=10,2,5 agent=10,2,5 sub_agent=5,1,2 crossing=2,1,1 cost=1

# Refused, each as a wrong key is: a key that is not a login key, one keyd holds, a label set not
# owned, one the manifest does not give, an unknown principal.
event now=1 random=[101,102] reply=1 Login principal="alice" labels=[] key=21
event now=1 random=[101,102] reply=2 Login principal="alice" labels=[] key=31
event now=1 random=[101,102] reply=3 Login principal="alice" labels=[8] key=11
event now=1 random=[101,102] reply=4 Login principal="alice" labels=[9] key=11
event now=1 random=[101,102] reply=5 Login principal="carol" labels=[] key=11
# Started, then running: its batch done, it is routed and numbered.
event now=2 random=[101,102,103] reply=6 Login principal="alice" labels=[] key=11
event now=3 Done object=session@1/#101 ok=[budget(901),scope,connection,connection,process(77)]
# A second session in the vault, then its channel closes.
event now=4 random=[201,202,203] reply=7 Login principal="alice" labels=[7] key=11
event now=5 Done object=session@1/7#201 ok=[budget(902),scope,connection,connection,process(78)]
event now=6 reply=8 ChannelClosed session=201
event now=7 Done object=session@1/7#201 ok=[done]
# The first ends itself; its destroy fails, and it ends all the same.
event now=8 reply=9 EndSession badge=102
event now=9 Done object=session@1/#101 failed=0,3
# Bob's session fails to start, and the failure is his answer.
event now=10 random=[301,302,303] reply=10 Login principal="bob" labels=[] key=12
event now=11 Done object=session@2/#301 failed=3,5
event now=12 Done object=session@2/#301 failed=0,1
# Events naming nothing get one answer; a session's end on a lease badge names nothing.
event now=13 reply=11 ChannelClosed session=999
event now=13 reply=12 EndSession badge=999
event now=13 Exited object=session@1/#999
event now=13 Done object=session@1/#999 ok=[]
# Contexts: alice's `work` starts; a second login to it while it lives is refused in use, and
# one naming a context that is not a name is refused as a wrong key is.
event now=13 random=[601,602,603] reply=15 Login principal="alice" labels=[] context="work" key=11
event now=13 Done object=session@1/#601 ok=[budget(903),scope,connection,connection,process(79)]
event now=13 random=[701,702,703] reply=16 Login principal="alice" labels=[] context="work" key=11
event now=13 random=[701,702,703] reply=17 Login principal="alice" labels=[] context="Work" key=11
# Bob again, and an exit while he is starting: the guarantee is broken, the steward exits, and
# decides nothing more.
event now=14 random=[401,402,403] reply=13 Login principal="bob" labels=[] key=12
event now=15 Exited object=session@2/#401
event now=16 random=[501,502] reply=14 Login principal="bob" labels=[] key=12
