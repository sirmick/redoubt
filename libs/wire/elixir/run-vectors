#!/usr/bin/env bash
# Runs the typed-message vector files (libs/wire/vectors/example*.txt) through the generated
# Elixir codec on the real BEAM (the oracle) and on beamlet. Each must accept every accepted
# line exactly and refuse every refused one, and the two outputs must be identical byte for
# byte. The Rust codec runs the same files (cargo test -p redoubt-wire).
#
#   libs/wire/elixir/run-vectors
#
# BEAMLET is a prebuilt beamlet binary (default: built from userland/otp with the all-Rust regex
# engine, the one that runs on Redoubt).
set -euo pipefail
wire="$(cd "$(dirname "$0")/.." && pwd)"
repo="$(cd "$wire/../.." && pwd)"
. "$repo/userland/otp/tools/oracle.sh"

out="$(mktemp -d)"
trap 'rm -rf -- "$out"' EXIT
elixirc --ignore-module-conflict -o "$out/ebin" "$wire/elixir/wire.ex" "$wire"/elixir/proto/*.ex "$wire/elixir/test/vectors_test.ex" > /dev/null

# Both print the per-file lines, then the result (`ok` or `failed`) on the last line.
elixir -pa "$out/ebin" -e 'IO.puts(Redoubt.Wire.VectorsTest.start(Enum.at(System.argv(), 0)))' "$wire/vectors" > "$out/beam.txt"
on_beamlet "$wire/vectors" "$out/ebin" Elixir.Redoubt.Wire.VectorsTest > "$out/beamlet.txt"
sed 's/^/BEAM:    /' "$out/beam.txt"
if ! cmp -s "$out/beam.txt" "$out/beamlet.txt"; then
    sed 's/^/beamlet: /' "$out/beamlet.txt"
    echo "FAIL: BEAM and beamlet disagree"
    exit 1
fi
echo "beamlet: identical"
if [ "$(tail -n 1 "$out/beam.txt")" != "ok" ]; then
    echo "FAIL"
    exit 1
fi
echo "PASS"
