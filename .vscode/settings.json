{
    "rust-analyzer.cargo.target": "riscv64imac-unknown-none-elf",
    "rust-analyzer.files.excludeDirs": [
        "./bios/**",
        "./reference/**",
        "./toolchains/**",
        "./userland/otp/**",
        "./vendor/**"
    ],
    "rust-analyzer.rustfmt.extraArgs": ["+nightly"],
    "files.trimTrailingWhitespace": true,
    "editor.formatOnSave": true
}