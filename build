#!/usr/bin/env bash
#
# build -- compile the Redoubt boot chain for one architecture.
#
# Usage: ./build [--arch rv32|rv64] [--debug] [--programs]
#   --arch      target width (default rv64)
#   --debug     build the unoptimized debug profile instead of release
#   --programs  also build the in-guest test programs
#
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

arch=rv64
release=1
programs=0
while (($#)); do
    case "$1" in
        -a|--arch)  arch="${2:?--arch needs rv32 or rv64}"; shift 2 ;;
        --arch=*)   arch="${1#*=}"; shift ;;
        --release)  release=1; shift ;; # retained for compatibility; release is the default
        --debug)    release=0; shift ;;
        --programs) programs=1; shift ;;
        -h|--help)  sed -n '2,10p' "$0"; exit 0 ;;
        *) echo "build: unknown argument: $1" >&2; exit 2 ;;
    esac
done

case "$arch" in
    rv32) triple=riscv32imac-unknown-none-elf ;;
    rv64) triple=riscv64imac-unknown-none-elf ;;
    *) echo "build: --arch must be rv32 or rv64 (got $arch)" >&2; exit 2 ;;
esac

profile=()
if [ "$release" = 1 ]; then profile=(--release); fi

echo "==> kernel ($triple)"
cargo build "${profile[@]}" --target "$triple" -p redoubt-kernel --features qemu-virt
echo "==> loader ($triple)"
cargo build "${profile[@]}" --target "$triple" -p loader
if [ "$programs" = 1 ]; then
    echo "==> test programs ($triple)"
    cargo build "${profile[@]}" --target "$triple" -p test-programs
fi
echo "==> done"
