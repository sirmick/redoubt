#!/usr/bin/env bash
#
# mkimage -- build the signed boot bundle from image/boot.toml into target/image/, and prepare the
# disk-image staging directory the image builder fills before packaging a littlefs volume.
#
# Usage: ./mkimage [--arch rv32|rv64]
#
#   target/image/redoubt.bundle   signed "signature || ustar" archive the loader verifies: the
#                                 kernel, init, the servers and the boot manifest
#   target/image/stage/           tree to be packed into the disk image (filled later;
#                                 sources and recipes live in image/)
#
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

arch=rv64
while (($#)); do
    case "$1" in
        -a|--arch)   arch="${2:?--arch needs rv32 or rv64}"; shift 2 ;;
        --arch=*)    arch="${1#*=}"; shift ;;
        -h|--help)   sed -n '2,12p' "$0"; exit 0 ;;
        *) echo "mkimage: unknown argument: $1" >&2; exit 2 ;;
    esac
done

mkdir -p target/image/stage

# The bench's builder packs the recipe, the same bundle the `init-boot` case boots: `--run
# --print-only` builds and signs it, then stops before booting. The archive lands at
# target/testbench/interactive.tar.
cargo run --quiet -p testbench -- --arch "$arch" --run --print-only --recipe image/boot.toml

cp -f target/testbench/interactive.tar target/image/redoubt.bundle
echo "==> boot bundle: target/image/redoubt.bundle"
echo "==> disk staging: target/image/stage (sources and recipes live in image/)"
